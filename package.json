{
  "name": "even-g2-pomodoro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pomodoro focus timer for Even Realities G2 smart glasses",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "qr": "evenhub qr --http --port 5173",
    "simulate": "evenhub-simulator http://localhost:5173",
    "pack": "npm run build && evenhub pack app.json dist -o even-g2-pomodoro.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.13",
    "@evenrealities/evenhub-simulator": "^0.7.3",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
